# ============================================================================
#  GulfZone HR — environment template
#  Copy to .env.local and fill in DEV values. .env.local is gitignored.
#
#  ⚠  NEVER put the CLIENT / PRODUCTION Supabase project in a developer's
#     .env.local. The Supabase guard (scripts/guard-supabase.js) will refuse
#     to run `npm run dev` / `npm run build` if it detects a blocked
#     (production) project ref. Production config lives ONLY on the client
#     server.
# ============================================================================

# --- DEV Supabase project (your own clone — safe to read/write) -------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-DEV-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-DEV-SERVICE-ROLE-KEY

# --- App config -------------------------------------------------------------
NEXT_PUBLIC_BASE_PATH=/HRportal
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Feature flags ----------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
