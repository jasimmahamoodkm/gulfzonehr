# ============================================================================
#  GulfZone HR - Production environment variables
#  Copy this file to  .env.local  at the PROJECT ROOT (not in deploy/windows)
#  and fill in the real values from your Supabase project settings.
#
#  IMPORTANT: NEXT_PUBLIC_* values are baked into the build. If you change
#  them, you must re-run `npm run build`.
# ============================================================================

# Supabase project URL  (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon / publishable key  (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase service role key  (SERVER ONLY - never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Application base path - the app is served under /HRportal
NEXT_PUBLIC_BASE_PATH=/HRportal

# Public URL used by server-side email links etc. Set to the real domain.
NEXT_PUBLIC_APP_URL=https://hr.clientdomain.com

# Environment
NODE_ENV=production
